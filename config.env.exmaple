# ==============================================================================
# ngx-cert-manager Global Configuration File
# ==============================================================================

# Application Meta
NGX_CERT_MANAGER_VERSION="1.0.0"

# Root & Path Configuration
# ACME Webroot Directory for Let's Encrypt HTTP-01 challenge verification
ACME_WEBROOT_DIR="${ACME_WEBROOT_DIR:-/var/www/certbot}"

# Nginx Configuration Directories
NGINX_CONF_DIR="${NGINX_CONF_DIR:-/etc/nginx/conf.d}"
NGINX_MAIN_CONF="${NGINX_MAIN_CONF:-/etc/nginx/nginx.conf}"
NGINX_BACKUP_DIR="${NGINX_BACKUP_DIR:-/etc/nginx/conf.d/.backup}"
NGINX_BIN="${NGINX_BIN:-nginx}"

# Logging
# Operation log file path (will fallback to user home if /var/log is not writable)
LOG_FILE="${LOG_FILE:-/var/log/ngx-cert-manager.log}"
LOG_FALLBACK_DIR="${HOME:-/tmp}/.ngx-cert-manager"

# Let's Encrypt & Certbot Configuration
# 1 = use Let's Encrypt staging environment (--test-cert), 0 = production
CERTBOT_STAGING="${CERTBOT_STAGING:-0}"
CERTBOT_BIN="${CERTBOT_BIN:-certbot}"
CERTBOT_RENEW_SERVICE_NAME="certbot-renew.service"
CERTBOT_RENEW_TIMER_NAME="certbot-renew.timer"
SYSTEMD_SYSTEM_DIR="${SYSTEMD_SYSTEM_DIR:-/etc/systemd/system}"
CRON_D_DIR="${CRON_D_DIR:-/etc/cron.d}"

# ==============================================================================
# Cloudflare DNS-01 验证模式配置 (专为内网服务器 / 无公网IP / FRP 穿透 / 泛域名设计)
# ==============================================================================
# 【如何获取 Cloudflare API Token (只需 1 分钟)】:
# 1. 登录 Cloudflare 网页控制台: https://dash.cloudflare.com/
# 2. 点击右上角头像 -> 点击「My Profile (我的个人资料)」-> 左侧导航栏选择「API Tokens」
# 3. 点击页面中的「Create Token (创建令牌)」按钮
# 4. 在模板列表中找到「Edit zone DNS (编辑区域 DNS)」模板，点击其右侧的「Use template (使用模板)」
# 5. 配置权限与适用域名:
#    - Permissions (权限): 保持默认的「Zone - DNS - Edit」
#    - Zone Resources (区域资源): 
#        选择「Include」 -> 「Specific zone」 -> 在下拉菜单中选择你的目标域名 (或者选「All zones」)
# 6. 滚动到页面底部，点击「Continue to summary (继续以查看摘要)」-> 点击「Create Token (创建令牌)」
# 7. 复制生成的 40 位 Token 字符串，粘贴至下方的 CF_DNS_API_TOKEN 变量中。
#
# 安全提示:
#   该 Token 仅具备添加/删除临时 _acme-challenge TXT 记录的权限，无其他管理权限。
#   系统会将凭证妥善保存在权限为 600 (仅 root 可读写) 的 /etc/letsencrypt/cloudflare.ini 中。
# ==============================================================================
CF_DNS_API_TOKEN=""

# 默认证书签发模式:
# - "webroot": 常规 HTTP-01 零停机验证 (默认模式，要求服务器有公网 80 端口且解析对齐)
# - "dns_cf" : Cloudflare DNS-01 自动验证 (内网无公网IP / FRP 穿透 / 非80端口 / 泛域名 *.domain.com)
# 说明: 当配置了 CF_DNS_API_TOKEN 或在命令行指定了 --dns-cf 时，系统将自动启用 dns_cf 模式。
DEFAULT_CERT_MODE="${DEFAULT_CERT_MODE:-webroot}"

# Cloudflare DNS TXT 记录传播生效等待时间 (秒，Cloudflare 解析通常极快，默认 15 秒)
CF_PROPAGATION_SECONDS="${CF_PROPAGATION_SECONDS:-15}"

# Cloudflare API 凭证存储路径 (受权限 600 保护)
CF_CREDENTIALS_FILE="${CF_CREDENTIALS_FILE:-/etc/letsencrypt/cloudflare.ini}"

# Certificate Validity Thresholds (Days)
CERT_WARN_DAYS=30
CERT_CRITICAL_DAYS=15

# Network & DNS Pre-flight Inspection
DNS_TIMEOUT=5
DNS_MAX_RETRIES=12
DNS_RETRY_INTERVAL=5

# Public IP Discovery Providers (IPv4)
PUBLIC_IPV4_APIS=(
    "https://api.ipify.org"
    "https://ifconfig.me/ip"
    "https://icanhazip.com"
    "https://checkip.amazonaws.com"
)

# Public IP Discovery Providers (IPv6)
PUBLIC_IPV6_APIS=(
    "https://api6.ipify.org"
    "https://icanhazip.com"
)

# Reverse Proxy & Nginx Production Defaults
DEFAULT_CLIENT_MAX_BODY_SIZE="50m"
DEFAULT_PROXY_CONNECT_TIMEOUT="60s"
DEFAULT_PROXY_SEND_TIMEOUT="60s"
DEFAULT_PROXY_READ_TIMEOUT="60s"
DEFAULT_ENABLE_HSTS=1
DEFAULT_ENABLE_WEBSOCKET=1

# Cloudflare CDN IP Ranges (IPv4 prefix list for CDN detection)
CLOUDFLARE_IPV4_CIDRS=(
    "173.245.48.0/20"
    "103.21.244.0/22"
    "103.22.200.0/22"
    "103.31.4.0/22"
    "141.101.64.0/18"
    "108.162.192.0/18"
    "190.93.240.0/20"
    "188.114.96.0/20"
    "197.234.240.0/22"
    "198.41.128.0/17"
    "162.158.0.0/15"
    "104.16.0.0/13"
    "104.24.0.0/14"
    "172.64.0.0/13"
    "131.0.72.0/22"
)
