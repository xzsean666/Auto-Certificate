      --domain <domain>     目标域名
      --delete-cert         同时吊销并清理对应 SSL 证书

  cert                      SSL 证书全生命周期管理
    cert issue              申请签发 Let's Encrypt 证书
      --domain <domain>     目标域名 (必填)
      --email <email>       联系邮箱 (必填)
      --webroot             使用 Webroot 零中断模式 (默认)
      --standalone          使用 Standalone 独立模式 (兜底)
      --dns-cf              使用 Cloudflare DNS-01 API 验证模式 (内网/无公网IP/泛域名)
      --cf-token <token>    指定 Cloudflare API Token
      --staging             使用 Staging 测试环境
      --force               强制重新签发 (即使未到期)
    cert list               查看所有受管证书大盘与剩余有效期
    cert renew              执行自动化续期扫描
      --force               强制全部续期
      --dry-run             模拟演练测试续期
    cert revoke             吊销并清理证书
      --domain <domain>     目标域名

  nginx                     Nginx 服务与全局穿透规则运维
    nginx status            查看 Nginx 安装与运行状态
    nginx install           通过包管理器安装 Nginx
    nginx test              检查 Nginx 配置文件语法
    nginx reload            平滑重载 Nginx (带严格前置自检)
    nginx start             启动 Nginx 服务
    nginx stop              停止 Nginx 服务
    nginx restart           重启 Nginx 服务
    nginx bootstrap         初始化全局 ACME 穿透与 WebSocket Map 规则

  timer                     自动化续期守护与定时任务
    timer setup             注册并启用续期守护 (Systemd Timer / Cron)
    timer status            查看续期定时器运行状态
    timer trigger           立即触发单次续期测试
    timer logs              查看证书自动续期审计日志

  diagnose                  系统网络、IPv6、DNS 与端口占用综合体检

示例 (Examples):
  ngx-cert-manager                                      # 启动 TUI 交互式控制台
  ngx-cert-manager site add --domain api.test.com --upstream 127.0.0.1:8080 --email admin@test.com
  ngx-cert-manager site list
  ngx-cert-manager cert list
  ngx-cert-manager diagnose
  ngx-cert-manager --ssh root@192.168.1.50 site list   # 远程免安装运维
EOF
}

# Subcommand: diagnose
cmd_diagnose() {
    ui_banner "$(domain_get_public_ipv4 2>/dev/null || echo "127.0.0.1")" "${OS_NAME}"
    ui_section "1. 系统与运行环境"
    env_summary

    ui_section "2. Nginx 服务状态"
    nginx_status_summary
    if nginx_is_installed; then
        nginx_test || true
    fi

    ui_section "3. 网络与端口占用检测"
    local public_v4 public_v6
    public_v4="$(domain_get_public_ipv4 2>/dev/null || echo "无法获取")"
    public_v6="$(domain_get_public_ipv6 2>/dev/null || echo "无公网 IPv6")"
    echo "公网 IPv4: $public_v4"
    echo "公网 IPv6: $public_v6"

    ui_info "检查 80 端口占用情况..."
    domain_check_port_80 || true

    ui_section "4. 定时续期守护状态"
    echo "守护状态: $(timer_status_summary)"
}

# Subcommand: site
cmd_site() {
    local action="${1:-list}"
    shift || true

    case "$action" in
        list)
            proxy_list_sites
            ;;
        get)
            local domain=""
            while [ $# -gt 0 ]; do
                case "$1" in
                    --domain) domain="$2"; shift 2 ;;
                    --domain=*) domain="${1#*=}"; shift ;;
                    *) shift ;;
                esac
            done
            proxy_get_site "$domain"
            ;;
        delete)
            local domain=""
            local delete_cert=0
            while [ $# -gt 0 ]; do
                case "$1" in
                    --domain) domain="$2"; shift 2 ;;
                    --domain=*) domain="${1#*=}"; shift ;;
                    --delete-cert) delete_cert=1; shift ;;
                    *) shift ;;
                esac
            done
            proxy_delete_site "$domain" "$delete_cert"
            ;;
        add)
            local domain=""
            local upstream=""
            local email=""
            local hsts="${DEFAULT_ENABLE_HSTS:-1}"
            local body_size="${DEFAULT_CLIENT_MAX_BODY_SIZE:-50m}"
            local ws="${DEFAULT_ENABLE_WEBSOCKET:-1}"
            local skip_dns=0
            local staging=0
            local ssl_enabled=1
            local cert_mode="auto"
            local cf_token=""

            while [ $# -gt 0 ]; do
                case "$1" in
                    --domain) domain="$2"; shift 2 ;;
                    --domain=*) domain="${1#*=}"; shift ;;
                    --upstream) upstream="$2"; shift 2 ;;
                    --upstream=*) upstream="${1#*=}"; shift ;;
                    --email) email="$2"; shift 2 ;;
                    --email=*) email="${1#*=}"; shift ;;
                    --hsts) hsts=1; shift ;;
                    --no-hsts) hsts=0; shift ;;
                    --body-size) body_size="$2"; shift 2 ;;
                    --body-size=*) body_size="${1#*=}"; shift ;;
                    --ws) ws=1; shift ;;
                    --no-ws) ws=0; shift ;;
                    --skip-dns-check) skip_dns=1; shift ;;
                    --staging) staging=1; shift ;;
                    --no-ssl|--http-only) ssl_enabled=0; shift ;;
                    --ssl) ssl_enabled=1; shift ;;
                    --dns-cf|--dns-cloudflare) cert_mode="dns_cf"; shift ;;
                    --cf-token) cf_token="$2"; cert_mode="dns_cf"; shift 2 ;;
                    --cf-token=*) cf_token="${1#*=}"; cert_mode="dns_cf"; shift ;;
                    --webroot) cert_mode="webroot"; shift ;;
                    *) shift ;;
                esac
            done

            proxy_add_site "$domain" "$upstream" "$email" "$hsts" "$body_size" "$ws" "$skip_dns" "$staging" "1" "$ssl_enabled" "$cert_mode" "$cf_token"
            ;;
        *)
            ui_error "未知的 site 操作: $action"
            show_help
            return 1
            ;;
    esac
}

# Subcommand: cert
cmd_cert() {
    local action="${1:-list}"
    shift || true

    case "$action" in
        list)
            cert_list
            ;;
        renew)
            local force=0
            local dry_run=0
            while [ $# -gt 0 ]; do
                case "$1" in
                    --force) force=1; shift ;;
                    --dry-run) dry_run=1; shift ;;
                    *) shift ;;
                esac
            done
            cert_renew "$force" "$dry_run"
            ;;
        revoke)
            local domain=""
            while [ $# -gt 0 ]; do
                case "$1" in
                    --domain) domain="$2"; shift 2 ;;
                    --domain=*) domain="${1#*=}"; shift ;;
                    *) shift ;;
                esac
            done
            cert_revoke "$domain"
            ;;
        issue)
            local domain=""
            local email=""
            local mode="auto"
            local staging=0
            local force=0
            local cf_token=""

            while [ $# -gt 0 ]; do
                case "$1" in
                    --domain) domain="$2"; shift 2 ;;
                    --domain=*) domain="${1#*=}"; shift ;;
                    --email) email="$2"; shift 2 ;;
                    --email=*) email="${1#*=}"; shift ;;
                    --webroot) mode="webroot"; shift ;;
                    --standalone) mode="standalone"; shift ;;
                    --dns-cf|--dns-cloudflare) mode="dns_cf"; shift ;;
                    --cf-token) cf_token="$2"; mode="dns_cf"; shift 2 ;;
                    --cf-token=*) cf_token="${1#*=}"; mode="dns_cf"; shift ;;
                    --staging) staging=1; shift ;;
                    --force) force=1; shift ;;
                    *) shift ;;
                esac
            done

            if [ "$mode" = "standalone" ]; then
                cert_issue_standalone "$domain" "$email" "$staging"
            elif [ "$mode" = "dns_cf" ]; then
                cert_issue_dns_cloudflare "$domain" "$email" "$cf_token" "$staging" "$force"
            elif [ "$mode" = "webroot" ]; then
                cert_issue_webroot "$domain" "$email" "$staging" "$force"
            else
                # Auto mode: if cf_token provided, CF_DNS_API_TOKEN set, or DEFAULT_CERT_MODE is dns_cf
                if [ -n "$cf_token" ] || [ -n "${CF_DNS_API_TOKEN:-}" ] || [ "${DEFAULT_CERT_MODE:-webroot}" = "dns_cf" ]; then
                    cert_issue_dns_cloudflare "$domain" "$email" "$cf_token" "$staging" "$force"
                else
                    cert_issue_webroot "$domain" "$email" "$staging" "$force"
                fi
            fi
            ;;
        *)
            ui_error "未知的 cert 操作: $action"
            show_help
            return 1
            ;;
    esac
}

