#!/usr/bin/env bash
# ==============================================================================
# ngx-cert-manager
# Nginx & Let's Encrypt 一体化运维管理套件 (Unified CLI Entrypoint & TUI Suite)
# ==============================================================================

set -eo pipefail

# 1. Resolve Runtime Directory & Resource Locations (Dynamic Self-Adaptive Path)
# Supports both:
#  A) Standalone local git checkout repository execution (./ngx-cert-manager)
#  B) System-wide installation (/usr/bin/ngx-cert-manager, /usr/share/ngx-cert-manager)
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
CURRENT_BIN_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

# Check if running in local source repository or installed system location
if [ -f "$CURRENT_BIN_DIR/lib/ui.sh" ] && [ -d "$CURRENT_BIN_DIR/templates" ]; then
    # Local Git Repository Mode
    export NGX_APP_ROOT="$CURRENT_BIN_DIR"
    export NGX_LIB_DIR="$CURRENT_BIN_DIR/lib"
    export NGX_TEMPLATES_DIR="$CURRENT_BIN_DIR/templates"
    export NGX_CONFIG_FILE="${NGX_CONFIG_FILE:-$CURRENT_BIN_DIR/config.env}"
elif [ -d "/usr/share/ngx-cert-manager/lib" ]; then
    # System Installed Mode (/usr/share/ngx-cert-manager)
    export NGX_APP_ROOT="/usr/share/ngx-cert-manager"
    export NGX_LIB_DIR="/usr/share/ngx-cert-manager/lib"
    export NGX_TEMPLATES_DIR="/usr/share/ngx-cert-manager/templates"
    export NGX_CONFIG_FILE="${NGX_CONFIG_FILE:-/etc/ngx-cert-manager/config.env}"
    [ ! -f "$NGX_CONFIG_FILE" ] && export NGX_CONFIG_FILE="/usr/share/ngx-cert-manager/config.env"
elif [ -d "/usr/local/share/ngx-cert-manager/lib" ]; then
    # Local System Installed Mode (/usr/local/share/ngx-cert-manager)
    export NGX_APP_ROOT="/usr/local/share/ngx-cert-manager"
    export NGX_LIB_DIR="/usr/local/share/ngx-cert-manager/lib"
    export NGX_TEMPLATES_DIR="/usr/local/share/ngx-cert-manager/templates"
    export NGX_CONFIG_FILE="${NGX_CONFIG_FILE:-/etc/ngx-cert-manager/config.env}"
    [ ! -f "$NGX_CONFIG_FILE" ] && export NGX_CONFIG_FILE="/usr/local/share/ngx-cert-manager/config.env"
else
    # Fallback to current script directory
    export NGX_APP_ROOT="$CURRENT_BIN_DIR"
    export NGX_LIB_DIR="$CURRENT_BIN_DIR/lib"
    export NGX_TEMPLATES_DIR="$CURRENT_BIN_DIR/templates"
    export NGX_CONFIG_FILE="${NGX_CONFIG_FILE:-$CURRENT_BIN_DIR/config.env}"
fi

# 2. Source Configuration and Modules
[ -f "$NGX_CONFIG_FILE" ] && source "$NGX_CONFIG_FILE"
[ -f "$NGX_LIB_DIR/ui.sh" ] && source "$NGX_LIB_DIR/ui.sh"
[ -f "$NGX_LIB_DIR/env.sh" ] && source "$NGX_LIB_DIR/env.sh"
[ -f "$NGX_LIB_DIR/nginx.sh" ] && source "$NGX_LIB_DIR/nginx.sh"
[ -f "$NGX_LIB_DIR/domain.sh" ] && source "$NGX_LIB_DIR/domain.sh"
[ -f "$NGX_LIB_DIR/cert.sh" ] && source "$NGX_LIB_DIR/cert.sh"
[ -f "$NGX_LIB_DIR/proxy.sh" ] && source "$NGX_LIB_DIR/proxy.sh"
[ -f "$NGX_LIB_DIR/systemd.sh" ] && source "$NGX_LIB_DIR/systemd.sh"
[ -f "$NGX_LIB_DIR/remote.sh" ] && source "$NGX_LIB_DIR/remote.sh"

