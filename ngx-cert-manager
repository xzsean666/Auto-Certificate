# Interactive Wizard: Create Reverse Proxy Site
tui_wizard_add_site() {
    ui_section "向导: 快速创建反向代理站点"

    local domain=""
    while [ -z "$domain" ]; do
        domain="$(ui_prompt "1. 请输入绑定的域名 (例如: api.example.com)")"
    done

    local upstream=""
    while [ -z "$upstream" ]; do
        upstream="$(ui_prompt "2. 请输入后端上游地址 (例如: 127.0.0.1:3000 或 unix:/run/app.sock:)")"
    done

    local enable_ssl=1
    if ! ui_confirm "3. 是否自动配置 HTTPS 与申请 SSL 证书 (若通过 Cloudflare 边缘代理/内网可选 N)?" "Y"; then
        enable_ssl=0
    fi

    local email=""
    local enable_hsts=0
    local staging=0
    local cert_mode="webroot"
    local cf_token=""
    if [ "$enable_ssl" -eq 1 ]; then
        email="$(ui_prompt "4. 请输入 Let's Encrypt 联系邮箱" "admin@${domain#\*.}")"

        echo ""
        local mode_choice
        mode_choice="$(ui_select "请选择 SSL 证书签发验证模式:" \
            "Webroot 模式 (HTTP-01 零停机验证，需公网 80 端口与 IP 解析对齐)" \
            "Cloudflare DNS-01 模式 (API 验证，适用于内网/无公网IP/FRP穿透/泛域名)")"

        if [ "$mode_choice" = "2" ]; then
            cert_mode="dns_cf"
            if [ -z "${CF_DNS_API_TOKEN:-}" ]; then
                cf_token="$(ui_prompt "请输入 Cloudflare API Token")"
            else
                ui_info "已检测到 config.env 中的 Cloudflare API Token。"
            fi
        else
            cert_mode="webroot"
        fi

        if ui_confirm "5. 是否开启 HSTS 强制安全防护?" "Y"; then
            enable_hsts=1
        fi
        if ui_confirm "6. 是否使用 Let's Encrypt Staging 沙箱测试环境 (推荐首次调试使用)?" "N"; then
            staging=1
        fi
    fi

    local enable_ws=1
    if ! ui_confirm "7. 是否启用 WebSocket 协议升级支持?" "Y"; then
        enable_ws=0
    fi

    local body_size
    body_size="$(ui_prompt "8. 客户端请求体大小限制 (client_max_body_size)" "${DEFAULT_CLIENT_MAX_BODY_SIZE:-50m}")"

    echo ""
    ui_info "配置概要确认:"
    echo "  - 域名: $domain"
    echo "  - 上游: $(proxy_normalize_upstream "$upstream")"
    echo "  - SSL 模式: $([ "$enable_ssl" -eq 1 ] && echo "开启 HTTPS (Let's Encrypt)" || echo "纯 HTTP 80 端口反代")"
    [ "$enable_ssl" -eq 1 ] && echo "  - 签发方式: $([ "$cert_mode" = "dns_cf" ] && echo "Cloudflare DNS-01 API" || echo "HTTP-01 Webroot")"
    [ "$enable_ssl" -eq 1 ] && echo "  - 邮箱: $email"
    [ "$enable_ssl" -eq 1 ] && echo "  - HSTS: $([ "$enable_hsts" -eq 1 ] && echo "开启" || echo "关闭")"
    echo "  - WebSocket: $([ "$enable_ws" -eq 1 ] && echo "开启" || echo "关闭")"
    echo "  - 上传限制: $body_size"
    [ "$enable_ssl" -eq 1 ] && echo "  - 环境: $([ "$staging" -eq 1 ] && echo "Staging 沙箱" || echo "生产环境")"
    echo ""

    if ui_confirm "确认立即开始自动化部署?" "Y"; then
        proxy_add_site "$domain" "$upstream" "$email" "$enable_hsts" "$body_size" "$enable_ws" "0" "$staging" "0" "$enable_ssl" "$cert_mode" "$cf_token"
    else
        ui_warn "已取消部署。"
    fi
}

# Interactive TUI Main Loop
tui_main_loop() {
    while true; do
        clear 2>/dev/null || true
        local s_ip s_os
        s_ip="$(domain_get_public_ipv4 2>/dev/null || echo "127.0.0.1")"
        s_os="${OS_NAME}"

        ui_banner "$s_ip" "$s_os"

        # Dashboard Top Overview
        local ngx_stat
        ngx_stat="$(nginx_status_summary)"
        local timer_stat
        timer_stat="$(timer_status_summary)"

        echo "【Nginx 状态】: $ngx_stat"
        echo "【自动 续期】: $timer_stat"
        echo "--------------------------------------------------------------------------------"
        echo " 1. [一键向导] 域名预检 + 签发证书 + 配置 SSL 反代 (零停机)"
        echo " 2. [站点管理] 查看所有代理站点 / 新增 / 查看配置 / 删除站点"
        echo " 3. [证书中心] 证书列表大盘 / 手动签发 / 强制续期 / 吊销证书"
        echo " 4. [Nginx运维] 安装或检测 / 语法校验 / 平滑重载 / 启停控制 / 全局规则注入"
        echo " 5. [定时守护] 注册续期定时器 / 查看守护状态 / 立即触发测试 / 查看审计日志"
        echo " 6. [系统体检] 网络 IP 嗅探 / IPv6 支持分析 / 80 端口占用排查 / 综合体检"
        echo " 0. 退出管理套件"
        echo "================================================================================"

        local choice
        choice="$(ui_prompt "请输入操作编号 [0-6]" "1")"

        case "$choice" in
            1)
                tui_wizard_add_site
                ;;
            2)
                proxy_list_sites
                ;;
            3)
                cert_list
                ;;
            4)
                ui_section "Nginx 运维控制"
                nginx_status_summary
                if ui_confirm "是否执行平滑重载 (reload)?" "Y"; then
                    nginx_reload || true
                fi
                ;;
            5)
                systemd_status_timer || true
                if ui_confirm "是否立即触发一次测试续期?" "N"; then
                    systemd_trigger_now || true
                fi
                ;;
            6)
                cmd_diagnose
                ;;
            0)
                ui_info "感谢使用 ngx-cert-manager，再见！"
                exit 0
                ;;
            *)
                ui_warn "无效的操作编号，请重新选择。"
                ;;
        esac

        echo ""
        read -r -p "按 Enter 回车键返回主菜单..." || true
    done
}

# Main Entrypoint Dispatcher
main() {
    # Parse global SSH flags (supports --ssh and --ssh-key/-i in any order)
    local ssh_target=""
    local sub_args=()
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --ssh)
                ssh_target="$2"
                shift 2
                ;;
            --ssh=*)
                ssh_target="${1#*=}"
                shift
                ;;
            --ssh-key|-i)
                export SSH_KEY="$2"
                shift 2
                ;;
            --ssh-key=*)
                export SSH_KEY="${1#*=}"
                shift
                ;;
            *)
                sub_args+=("$1")
                shift
                ;;
        esac
    done

    if [ -n "$ssh_target" ]; then
        remote_execute "$ssh_target" "${sub_args[@]}"
        exit $?
    fi

    # Restore sub_args for local command dispatching
    set -- "${sub_args[@]}"

    # Global flags
    if [ "$#" -gt 0 ]; then
        case "$1" in
            -h|--help|help)
                show_help
                exit 0
                ;;
            -v|--version|version)
                echo "ngx-cert-manager v${NGX_CERT_MANAGER_VERSION:-1.0.0}"
                exit 0
                ;;
            site)
                shift
                cmd_site "$@"
                exit $?
                ;;
            cert)
                shift
                cmd_cert "$@"
                exit $?
                ;;
            nginx)
                shift
                cmd_nginx "$@"
                exit $?
                ;;
            timer)
                shift
                cmd_timer "$@"
                exit $?
                ;;
            diagnose)
                shift
                cmd_diagnose "$@"
                exit $?
                ;;
            remote)
                shift
                if [ "$#" -lt 1 ]; then
                    ui_error "请指定远程主机: ngx-cert-manager remote <user@host> [subcommand...]"
                    exit 1
                fi
                local target="$1"
                shift
                remote_execute "$target" "$@"
                exit $?
                ;;
            *)
                ui_error "未知的命令或选项: $1"
                show_help
                exit 1
                ;;
        esac
    fi

    # No arguments passed: If terminal is interactive, enter TUI, else show help
    if [ -t 0 ]; then
        tui_main_loop
    else
        show_help
    fi
}

main "$@"
